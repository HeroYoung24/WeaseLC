    PUSHBUTTON "Long passages: 5s",IDC_AUTO_LONG,170,235,145,18
    LTEXT "Hints stay after the minimum and end at expiry or source changes. Continuous hints do not record correction history.",IDC_STATIC1,10,257,330,21
    LTEXT "",IDC_AUTO_STATE,10,337,175,20
    DEFPUSHBUTTON "OK",IDOK,190,340,70,16
    PUSHBUTTON "Cancel",IDCANCEL,270,340,70,16
END

