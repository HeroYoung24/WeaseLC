    CONTROL         "",IDC_SCHEMA_LIST,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,21,136,103
    LTEXT           "Select a schema in the list to view an introduction",IDC_SCHEMA_DESCRIPTION,148,21,165,103
    LTEXT           "The following shortcut keys can call up the schema menu",IDC_STATIC1,7,132,273,8
    EDITTEXT        IDC_HOTKEYS,7,147,136,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Get more input schemas...",IDC_GET_SCHEMATA,7,169,90,14
    DEFPUSHBUTTON   "OK",IDOK,255,169,53,14
END

IDD_DICT_MANAGEMENT DIALOGEX 0, 0, 417, 265
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dictionary Manager"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Dictionary List: ",IDC_STATIC1,7,7,57,8
    LISTBOX         IDC_USER_DICT_LIST,7,23,108,214,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "When you need to migrate a user dictionary containing input habits to another system equipped with Rime input method, please select the dictionary name in the left column.",IDC_STATIC1,128,27,281,20
    LTEXT           "[Output Snapshot] It transfers snapshot files to another system.",IDC_STATIC1,128,55,281,15
    LTEXT           "[Merge Snapshot] It merges the entries from the snapshot file into the dictionary where they belong.",IDC_STATIC1,128,75,281,18
    PUSHBUTTON      "Output Snapshot",IDC_BACKUP,128,105,84,16
    PUSHBUTTON      "Merge Snapshot",IDC_RESTORE,280,105,84,16
    LTEXT           "[Export Text Table] It is a function designed for input schema makers. It can export the newly created phrases during use in the table format of the Rime dictionary for easy viewing and editing.",IDC_STATIC1,128,146,281,45
    LTEXT           "[Import Text Table] It can be used to organize lexicon from other sources into TSV format and then import it into Rime. To transfer data between Rime input methods, use a Dictionary Snapshot.",IDC_STATIC1,128,180,281,45
    PUSHBUTTON      "Export Text Table",IDC_EXPORT,128,220,84,16
    PUSHBUTTON      "Import Text Table",IDC_IMPORT,280,220,84,16
END


IDD_CORRECTION_SETTINGS DIALOGEX 0, 0, 560, 402
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WeaseLC · Correction settings"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mode",IDC_STATIC1,7,7,546,38
    AUTORADIOBUTTON "Off (default)",IDC_CORRECTION_OFF,17,21,100,12,WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Local model",IDC_CORRECTION_LOCAL,132,21,100,12
    AUTORADIOBUTTON "Online service",IDC_CORRECTION_ONLINE,247,21,105,12
    LTEXT           "Automatic hints are off by default. Optional checks cover new Weasel commits only.",IDC_STATIC1,17,33,523,10
    GROUPBOX        "Model connection",IDC_STATIC1,7,52,290,148
    LTEXT           "Full endpoint URL:",IDC_STATIC1,17,65,270,10
    EDITTEXT        IDC_CORRECTION_ENDPOINT,17,77,270,14,ES_AUTOHSCROLL
    LTEXT           "Model name:",IDC_STATIC1,17,98,90,10
    EDITTEXT        IDC_CORRECTION_MODEL,112,95,175,14,ES_AUTOHSCROLL
    LTEXT           "Access token (not saved):",IDC_STATIC1,17,115,270,10
    EDITTEXT        IDC_CORRECTION_TOKEN,17,127,270,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Timeout (2–60 sec):",IDC_STATIC1,17,149,150,10
    EDITTEXT        IDC_CORRECTION_TIMEOUT,175,146,35,14,ES_NUMBER
    LTEXT           "sec",IDC_STATIC1,215,149,65,10
    AUTOCHECKBOX    "Request JSON output (disable if unsupported)",IDC_CORRECTION_JSON_MODE,17,168,270,12
    PUSHBUTTON "Local model control...",IDC_CORRECTION_MODEL_CONTROL,17,180,165,16
    GROUPBOX        "Prompt preferences",IDC_STATIC1,7,207,290,85
    LTEXT           "Timing:",IDC_STATIC1,17,222,95,10
    COMBOBOX        IDC_CORRECTION_TIMING,112,219,175,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sensitivity:",IDC_STATIC1,17,242,95,10
    COMBOBOX        IDC_CORRECTION_SENSITIVITY,112,239,175,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Custom minimum model score",IDC_CORRECTION_CUSTOM_SCORE,17,261,190,12
    EDITTEXT        IDC_CORRECTION_SCORE,215,258,35,14,ES_NUMBER
    LTEXT           "/100",IDC_STATIC1,253,261,34,10
    LTEXT           "Higher minimum scores show fewer hints. Scores are model estimates.",IDC_STATIC1,17,277,270,12
    GROUPBOX        "Manual check",IDC_STATIC1,303,52,250,272
    LTEXT           "Only this page is sent. Select a suggestion to apply it manually.",IDC_STATIC1,315,65,226,22
    EDITTEXT        IDC_CORRECTION_TEST_TEXT,315,90,226,41,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    AUTOCHECKBOX    "Allow sending this text to the HTTPS URL on the left",IDC_CORRECTION_CONSENT,315,136,226,24,BS_MULTILINE
    PUSHBUTTON      "Check text",IDC_CORRECTION_CHECK,315,164,105,16
    PUSHBUTTON      "Cancel check",IDC_CORRECTION_CANCEL_CHECK,436,164,105,16
    LTEXT           "Not connected.",IDC_CORRECTION_STATE,315,185,226,24
    LISTBOX         IDC_CORRECTION_SUGGESTIONS,315,214,226,35,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_CORRECTION_RESULT,315,253,226,36,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Apply here",IDC_CORRECTION_APPLY,315,294,70,16
    PUSHBUTTON      "Ignore once",IDC_CORRECTION_IGNORE,393,294,70,16
    LTEXT           "Changes this page only; Ctrl+Z undoes. Check again after editing.",IDC_STATIC1,315,314,226,10
    PUSHBUTTON      "Automatic hints/layout...",IDC_CORRECTION_AUTOMATIC,17,302,104,18
    PUSHBUTTON      "Manage kept terms...",IDC_CORRECTION_TERMS,125,302,78,18
    PUSHBUTTON      "Apps and data...",IDC_CORRECTION_APPS,207,302,80,18
    GROUPBOX        "Runtime status (saved settings)",IDC_STATIC1,7,326,546,51
    LTEXT           "",IDC_CORRECTION_SERVICE_STATE,17,338,410,12
    LTEXT           "",IDC_CORRECTION_SERVICE_MODEL,17,352,410,22
    PUSHBUTTON      "Recover service",IDC_CORRECTION_SERVICE_RETRY,437,338,104,16
    PUSHBUTTON      "Defaults",IDC_CORRECTION_DEFAULTS,7,382,100,14
    DEFPUSHBUTTON   "Save",IDOK,435,382,52,14
    PUSHBUTTON      "Cancel",IDCANCEL,501,382,52,14
END

