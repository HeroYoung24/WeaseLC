    EDITTEXT IDC_MODEL_ENDPOINT,10,185,390,16,ES_READONLY | ES_AUTOHSCROLL
    EDITTEXT IDC_MODEL_ALIAS,10,205,390,16,ES_READONLY | ES_AUTOHSCROLL
    LTEXT "本窗口可最小化；关闭即停止自己启动的模型，不接管已有服务。纠错需在管理纠错中另行开启。",IDC_STATIC1,10,226,285,33
    PUSHBUTTON "停止并关闭",IDCANCEL,302,238,98,20
END

