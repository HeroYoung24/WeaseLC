    EDITTEXT IDC_AUTO_GAP,170,75,70,14,ES_NUMBER
    LTEXT "Width (180–640):",IDC_STATIC1,10,100,145,12
    EDITTEXT IDC_AUTO_WIDTH,170,97,70,14,ES_NUMBER
    PUSHBUTTON "Preview sample",IDC_AUTO_PREVIEW,250,97,90,16
    LTEXT "Font (10–24):",IDC_STATIC1,10,122,145,12
    EDITTEXT IDC_AUTO_FONT,170,119,70,14,ES_NUMBER
    LTEXT "Check delay (100–2000 ms):",IDC_STATIC1,10,144,155,12
    EDITTEXT IDC_AUTO_DEBOUNCE,170,141,70,14,ES_NUMBER
    LTEXT "Word uses normal input only, without automatic hints or Tab correction. Other supported editors check recent commits. Focus/caret/source changes retire hints.",IDC_STATIC1,10,280,330,30
    LTEXT "Layout follows display scaling. Choose OK, then Save in the main window.",IDC_STATIC1,10,312,330,20
