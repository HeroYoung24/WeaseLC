    CONTROL "Use correction history to adapt hints (saved immediately)",IDC_APP_BEHAVIOR_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,226,350,14
    PUSHBUTTON "About your data...",IDC_APP_DATA,10,248,125,18
    PUSHBUTTON "Clear correction history...",IDC_APP_CLEAR_FEEDBACK,150,248,138,18
    PUSHBUTTON "Reset paused apps...",IDC_APP_RESET,10,266,150,18
