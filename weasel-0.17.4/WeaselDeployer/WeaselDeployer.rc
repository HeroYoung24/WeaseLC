    LTEXT           "/100",IDC_STATIC1,253,261,34,10
    LTEXT           "提高最低分数可减少提示。分数由模型估计。",IDC_STATIC1,17,277,270,12
    GROUPBOX        "手动检查",IDC_STATIC1,303,52,250,272
    LTEXT           "只发送本页文本；选中建议后可手动应用。",IDC_STATIC1,315,65,226,22
    EDITTEXT        IDC_CORRECTION_TEST_TEXT,315,90,226,41,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    AUTOCHECKBOX    "允许将本页文本发送到左侧 HTTPS 地址",IDC_CORRECTION_CONSENT,315,136,226,24,BS_MULTILINE
    PUSHBUTTON      "检查文本",IDC_CORRECTION_CHECK,315,164,105,16
    PUSHBUTTON      "取消检查",IDC_CORRECTION_CANCEL_CHECK,436,164,105,16
    LTEXT           "未连接。",IDC_CORRECTION_STATE,315,185,226,24
    LISTBOX         IDC_CORRECTION_SUGGESTIONS,315,214,226,35,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_CORRECTION_RESULT,315,253,226,36,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "应用到本页",IDC_CORRECTION_APPLY,315,294,70,16
    PUSHBUTTON      "忽略一次",IDC_CORRECTION_IGNORE,393,294,70,16
    LTEXT           "仅修改本页；Ctrl+Z 撤销，之后可重新检查。",IDC_STATIC1,315,314,226,10
    PUSHBUTTON      "自动提示与布局…",IDC_CORRECTION_AUTOMATIC,17,302,104,18
    PUSHBUTTON      "管理保留词…",IDC_CORRECTION_TERMS,125,302,78,18
    PUSHBUTTON      "应用与数据…",IDC_CORRECTION_APPS,207,302,80,18
    GROUPBOX        "运行状态（已保存配置）",IDC_STATIC1,7,326,546,51
    LTEXT           "",IDC_CORRECTION_SERVICE_STATE,17,338,410,12
    LTEXT           "",IDC_CORRECTION_SERVICE_MODEL,17,352,410,22
    PUSHBUTTON      "恢复纠错服务",IDC_CORRECTION_SERVICE_RETRY,437,338,104,16
