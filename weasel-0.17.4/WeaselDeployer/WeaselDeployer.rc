    PUSHBUTTON "选择PowerShell…",IDC_MODEL_BROWSE_SHELL,302,71,98,18
    PUSHBUTTON "启动本地模型",IDC_MODEL_START,10,100,130,19
    PUSHBUTTON "停止本窗口的模型",IDC_MODEL_STOP,150,100,150,19
    GROUPBOX "运行状态",IDC_STATIC1,10,127,390,51
