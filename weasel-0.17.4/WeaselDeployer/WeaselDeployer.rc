    LISTBOX IDC_APP_LIST,10,48,350,116,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_APP_NAME,10,170,210,15,ES_AUTOHSCROLL
