IDD_CORRECTION_AUTOMATIC DIALOGEX 0, 0, 350, 365
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自动纠错提示"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "开启自动提示（仅本地模型；默认关闭）",IDC_AUTO_ENABLED,10,10,330,14
    AUTOCHECKBOX "Tab 接受建议（Esc 忽略，重复 Tab 不重复纠错）",IDC_AUTO_TAB,10,30,330,14
    LTEXT "位置：",IDC_STATIC1,10,56,145,12
    COMBOBOX IDC_AUTO_SIDE,170,53,170,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "间距（0–48）：",IDC_STATIC1,10,78,145,12
    EDITTEXT IDC_AUTO_GAP,170,75,70,14,ES_NUMBER
    LTEXT "宽度（180–640）：",IDC_STATIC1,10,100,145,12
    EDITTEXT IDC_AUTO_WIDTH,170,97,70,14,ES_NUMBER
    PUSHBUTTON "预览提示（示例）",IDC_AUTO_PREVIEW,250,97,90,16
    LTEXT "字号（10–24）：",IDC_STATIC1,10,122,145,12
    EDITTEXT IDC_AUTO_FONT,170,119,70,14,ES_NUMBER
    LTEXT "检查等待（100–2000 毫秒）：",IDC_STATIC1,10,144,155,12
    EDITTEXT IDC_AUTO_DEBOUNCE,170,141,70,14,ES_NUMBER
    LTEXT "Word 仅普通输入，不读取上文、不显示自动提示、不接管 Tab。其他支持的应用仅检查本输入法上屏文字；光标、焦点或原文变化后建议失效。",IDC_STATIC1,10,280,330,30
    LTEXT "布局随屏幕缩放调整。点击确定后，在主窗口保存。",IDC_STATIC1,10,312,330,20
    AUTOCHECKBOX "连续纠错提示（短词上屏后保留，逐条处理）",IDC_AUTO_FLOW,10,166,330,14
    LTEXT "最短展示（1000–10000 毫秒）：",IDC_STATIC1,10,190,196,12
    EDITTEXT IDC_AUTO_MINIMUM,210,187,100,14,ES_NUMBER
    LTEXT "最长有效（5000–60000 毫秒）：",IDC_STATIC1,10,212,196,12
    EDITTEXT IDC_AUTO_MAXIMUM,210,209,100,14,ES_NUMBER
    PUSHBUTTON "短词参考：3秒",IDC_AUTO_SHORT,10,235,145,18
    PUSHBUTTON "长段参考：5秒",IDC_AUTO_LONG,170,235,145,18
    LTEXT "达到最短时间后仍保留提示；到期或原文失效时结束。连续提示模式不记录纠错使用行为。",IDC_STATIC1,10,257,330,21

    LTEXT "",IDC_AUTO_STATE,10,337,175,20
    DEFPUSHBUTTON "确定",IDOK,190,340,70,16
    PUSHBUTTON "取消",IDCANCEL,270,340,70,16
END

