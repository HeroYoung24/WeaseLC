    AUTOCHECKBOX    "要求 JSON 输出（不支持时可关闭）",IDC_CORRECTION_JSON_MODE,17,168,270,12
    PUSHBUTTON "本地模型运行…",IDC_CORRECTION_MODEL_CONTROL,17,180,165,16
    GROUPBOX        "提示偏好",IDC_STATIC1,7,207,290,85
    LTEXT           "提示时机：",IDC_STATIC1,17,222,95,10
    COMBOBOX        IDC_CORRECTION_TIMING,112,219,175,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "检测敏感度：",IDC_STATIC1,17,242,95,10
    COMBOBOX        IDC_CORRECTION_SENSITIVITY,112,239,175,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "自定义最低模型分数",IDC_CORRECTION_CUSTOM_SCORE,17,261,190,12
