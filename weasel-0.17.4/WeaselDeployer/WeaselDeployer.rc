    PUSHBUTTON "Cancel",IDCANCEL,294,266,66,18
END

IDD_CORRECTION_AUTOMATIC DIALOGEX 0, 0, 350, 365
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Automatic correction hints"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "Enable automatic hints (local model only; off by default)",IDC_AUTO_ENABLED,10,10,330,14
    AUTOCHECKBOX "Tab accepts (Esc dismisses; no repeat acceptance)",IDC_AUTO_TAB,10,30,330,14
    LTEXT "Position:",IDC_STATIC1,10,56,145,12
