    PUSHBUTTON "預覽提示（範例）",IDC_AUTO_PREVIEW,250,97,90,16
    LTEXT "字號（10–24）：",IDC_STATIC1,10,122,145,12
    EDITTEXT IDC_AUTO_FONT,170,119,70,14,ES_NUMBER
    LTEXT "檢查等待（100–2000 毫秒）：",IDC_STATIC1,10,144,155,12
    EDITTEXT IDC_AUTO_DEBOUNCE,170,141,70,14,ES_NUMBER
    LTEXT "Word 僅普通輸入，不讀取上文、不顯示自動提示、不接管 Tab。其他支援的應用僅檢查本輸入法上屏文字；游標、焦點或原文變化後建議失效。",IDC_STATIC1,10,280,330,30
    LTEXT "佈局隨螢幕縮放調整。按確定後，在主視窗儲存。",IDC_STATIC1,10,312,330,20
    AUTOCHECKBOX "連續糾錯提示（短詞上屏後保留，逐條處理）",IDC_AUTO_FLOW,10,166,330,14
    LTEXT "最短顯示（1000–10000 毫秒）：",IDC_STATIC1,10,190,196,12
    EDITTEXT IDC_AUTO_MINIMUM,210,187,100,14,ES_NUMBER
    LTEXT "最長有效（5000–60000 毫秒）：",IDC_STATIC1,10,212,196,12
    EDITTEXT IDC_AUTO_MAXIMUM,210,209,100,14,ES_NUMBER
    PUSHBUTTON "短詞參考：3秒",IDC_AUTO_SHORT,10,235,145,18
    PUSHBUTTON "長段參考：5秒",IDC_AUTO_LONG,170,235,145,18
    LTEXT "達到最短時間後仍保留提示；到期或原文失效時結束。連續提示模式不記錄糾錯使用行為。",IDC_STATIC1,10,257,330,21
    LTEXT "",IDC_AUTO_STATE,10,337,175,20
    DEFPUSHBUTTON "確定",IDOK,190,340,70,16
    PUSHBUTTON "取消",IDCANCEL,270,340,70,16
END

