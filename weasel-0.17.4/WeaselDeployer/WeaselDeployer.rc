IDD_LOCAL_MODEL DIALOGEX 0, 0, 410, 266
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "本地4B模型运行"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "选择含 Start-LocalModel.ps1 的已有4B模型目录。启动会执行该脚本校验及预热，不下载文件或读取输入文字。",IDC_STATIC1,10,10,390,35
